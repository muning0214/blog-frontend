# Frontend
node_modules/
dist/
dist-ssr/

# ---- 环境变量：真实接口地址不进仓库 ----
# *.local 已经覆盖 .env.local / .env.development.local
*.local
.env
.env.production
.env.development
# 但模板文件要保留，方便别人知道有哪些变量
!.env.example

# Editor
.vscode/
.idea/
*.iml

# Vite 在加载配置文件时会生成带时间戳的临时文件，有时不会被清理
vite.config.*.timestamp-*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db
