# Copy this file to .env.production and set your backend API URL
# After deploying the backend (e.g. to Railway/Render/Fly.io),
# set this to your backend's /api path, e.g.:
# VITE_API_BASE_URL=https://your-blog-api.railway.app/api
#
# You can also set this directly in Vercel Project Settings > Environment Variables
VITE_API_BASE_URL=http://localhost:8080
